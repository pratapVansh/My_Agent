# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048

# Application Configuration
APP_NAME=My_Agent
APP_VERSION=1.0.0
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=10000

# Memory Configuration
# ChromaDB - Long-term memory (resume, skills, projects)
CHROMA_PERSIST_DIR=./data/chroma

# PostgreSQL - Short-term memory (chat history, attendance, timetable)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=my_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# mem0 - Smart memory (preferences, interests)
MEM0_API_KEY=optional_if_using_cloud

# Cohere Embeddings (REQUIRED for production)
COHERE_API_KEY=
COHERE_MODEL=

# Qdrant Vector Database (REQUIRED for production)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT=30

# Text Chunking Configuration (Optional - uses defaults)
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Job Search (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Voice Input (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_STREAMING_ENABLED=false
# Backstop turn boundary. The Deepgram API floors this at 1000 ms.
DEEPGRAM_UTTERANCE_END_MS=1000
DEEPGRAM_VAD_EVENTS=true
# Trailing silence before a final result is marked speech_final. This is what
# decides how quickly the assistant starts answering — lower is snappier but
# more likely to cut in on someone pausing mid-sentence.
DEEPGRAM_ENDPOINTING_MS=500
# Note: interim results are always on. Deepgram only emits UtteranceEnd when
# they are, so turn detection depends on them.

# Voice turn behaviour
# A turn is bounded by progress, not elapsed time: speaking a long answer takes
# as long as it takes. This is the gap since the last token, audio frame, or
# spoken word before the turn is considered wedged.
VOICE_TURN_STALL_SECONDS=20
# Last-resort ceiling against a runaway turn.
VOICE_TURN_MAX_SECONDS=600
# Nudge captions later to compensate for the browser's own jitter buffer.
VOICE_CAPTION_OFFSET_SECONDS=0.15
VOICE_BARGEIN_MIN_WORDS=2
VOICE_HISTORY_TURNS=12

# Voice Output (Cartesia)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_MODEL_ID=sonic-2
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_VERSION=2024-06-10
CARTESIA_SAMPLE_RATE=24000

# LiveKit WebRTC (Phase 0 — not active yet, used in future phases)
# Get credentials from https://cloud.livekit.io or your self-hosted server
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice Agent Optimization Feature Flags (Phase 1)
# Enable these flags to activate ultra-low latency optimizations
STREAMING_STT_ENABLED=false          # Streaming STT: 50-200ms (vs 500-800ms chunk-based)
PARALLEL_WORKFLOW_ENABLED=false      # Parallel memory + planner: saves 200-400ms
BINARY_AUDIO_ENABLED=false           # Binary audio transport: removes 33% base64 overhead (Phase 2)
VAD_ENABLED=true                     # Voice Activity Detection: 300-500ms detection (vs 2s fixed timer)

# ── Authentication (REQUIRED) ────────────────────────────────────────────
# Generate every value below with:  python scripts/create_owner_password.py
#
# Two DIFFERENT secrets, 32+ chars each. Sharing one would let an access token
# be replayed as a refresh token. Rotating either ends all active sessions.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Owner account. The password exists only as a bcrypt hash — never in plaintext.
OWNER_USERNAME=vansh
OWNER_PASSWORD_HASH=
# Identity your data is filed under. Changing this orphans existing memory.
OWNER_USER_ID=vansh

# Token lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
OWNER_REFRESH_TOKEN_TTL_DAYS=30
GUEST_REFRESH_TOKEN_TTL_DAYS=7

# Anonymous read-only sessions for the public /recruiter view.
GUEST_SESSIONS_ENABLED=true

# Cookie transport. Defaults are correct for most setups:
#   development -> secure=false, samesite=lax
#   production  -> secure=true,  samesite=none  (frontend on another domain)
# SameSite=none REQUIRES Secure=true; startup refuses to run otherwise.
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_DOMAIN=.yourdomain.com
CSRF_PROTECTION_ENABLED=true

# ── Security & limits ────────────────────────────────────────────────────
# CORS: comma-separated origins allowed to call this API from a browser.
# MUST be set to your deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting (per client IP, per minute). Protects LLM/embedding/browser
# endpoints from cost- and resource-exhaustion abuse.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10        # login brute-force guard
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LLM_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_EXPENSIVE_PER_MINUTE=5

# Request size caps
MAX_UPLOAD_BYTES=10485760            # 10 MB
MAX_TEXT_UPLOAD_CHARS=500000
MAX_QUERY_CHARS=8000

# Ceiling on a single end-to-end agent run (seconds)
WORKFLOW_TIMEOUT_SECONDS=120

# SSRF guard: allow the ERP scraper to reach private/internal addresses.
# Leave false unless your ERP genuinely lives on an internal network.
ALLOW_PRIVATE_NETWORK_SCRAPING=false

# Verbose per-step tracing (logs raw user text). Defaults to on in development
# only; set explicitly to override.
# DEBUG_STEP_LOGGING=false

# ── PostgreSQL connection pool ───────────────────────────────────────────
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800

# Observability (LangSmith)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=my-agent
LANGSMITH_TRACING_ENABLED=false
# Optional custom endpoint
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
